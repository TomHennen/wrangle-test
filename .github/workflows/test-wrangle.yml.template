name: Test Wrangle

# Generated per wrangle PR by the dispatch script, which substitutes
# __WRANGLE_SHA__ with the PR's head SHA. This file is a template —
# the .template suffix prevents GitHub Actions from discovering it.
# See: https://github.com/TomHennen/wrangle/blob/main/test/integration/SPEC.md

on:
  push:
    branches: ["integration/**"]

jobs:
  test-shell:
    permissions:
      contents: read
    uses: TomHennen/wrangle/.github/workflows/build_shell.yml@__WRANGLE_SHA__
    with:
      scan-path: shell

  # Container fixture — exercises the default (verify-image: true) path.
  test-container:
    permissions:
      contents: read
      packages: write
      id-token: write
      actions: read
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_container.yml@__WRANGLE_SHA__
    with:
      path: container
      imagename: ghcr.io/tomhennen/wrangle-test-staging
      registry: ghcr.io
      release-events: non-pull-request   # explicit; matches the default
      # The SLSA generator sometimes misdetects public repos as private
      # when workflows run on branches pushed by PATs. This is safe —
      # wrangle-test is intentionally public and disposable.
      publish_provenance_for_private_repo: true
    secrets:
      gh_token: ${{ secrets.GITHUB_TOKEN }}

  # Container opt-out fixture — exercises verify-image: false. Same
  # composite, same provenance generation; only wrangle's verify step
  # is skipped. Catches regressions where the workflow incorrectly
  # gates something other than the verify job on this input.
  test-container-no-verify:
    permissions:
      contents: read
      packages: write
      id-token: write
      actions: read
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_container.yml@__WRANGLE_SHA__
    with:
      path: container
      imagename: ghcr.io/tomhennen/wrangle-test-staging-no-verify
      registry: ghcr.io
      release-events: non-pull-request
      publish_provenance_for_private_repo: true
      verify-image: false
    secrets:
      gh_token: ${{ secrets.GITHUB_TOKEN }}

  # Patch the Python fixture version to be unique per run so every
  # integration test exercises the full publish-to-TestPyPI path.
  prep-python:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2 # zizmor: ignore[artipacked] persist-credentials needed for git push
      - name: Set unique test version
        env:
          RUN_ID: ${{ github.run_id }}
        run: |
          set -euo pipefail
          sed -i "s/version = .*/version = \"0.0.1.dev${RUN_ID}\"/" python/pyproject.toml
          git config user.name "wrangle-integration"
          git config user.email "wrangle-integration@noreply"
          git add python/pyproject.toml
          git commit -m "Set test version 0.0.1.dev${RUN_ID}"
          git push

  # Python fixture — exercises the default (verify-provenance: true)
  # path AND the publish-to-TestPyPI path.
  test-python:
    needs: [prep-python]
    permissions:
      # Required by wrangle's provenance job (calls slsa-github-generator).
      # `contents: write` is mandated by the generator's upload-assets job
      # at startup even when upload-assets is false; matches the SLSA
      # reference example.
      contents: write
      id-token: write
      actions: read
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_python.yml@__WRANGLE_SHA__
    with:
      path: python
      release-events: non-pull-request   # explicit; matches the default

  # Python opt-out fixture — exercises the uv path AND verify-provenance: false.
  # Doubles up coverage: catches regressions in the uv tooling branch and in
  # the verify-opt-out branch in one fixture instead of running two builds.
  # Build-only (no publish) since publish coverage is in test-python.
  test-python-uv:
    permissions:
      contents: write
      id-token: write
      actions: read
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_python.yml@__WRANGLE_SHA__
    with:
      path: python-uv
      release-events: non-pull-request
      verify-provenance: false

  # Publish to TestPyPI directly (not via reusable workflow) because
  # PyPI Trusted Publishing requires the OIDC token from this workflow.
  # See: https://github.com/pypi/warehouse/issues/11096
  publish-python:
    # Mirror the canonical adopter pattern: gate publish on should-release
    # so wrangle's release-events input controls both wrangle's internal
    # gating and this publish job. With release-events: non-pull-request,
    # publish runs on integration/** push events (which is what dispatch
    # uses) but would not run on PRs.
    if: ${{ needs.test-python.outputs.should-release == 'true' }}
    needs: [test-python]
    runs-on: ubuntu-latest
    permissions:
      id-token: write
    steps:
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          # The reusable workflow namespaces the artifact name by the
          # path-derived shortname (see wrangle's build_and_publish_python.yml
          # outputs). Use the exported name rather than hardcoding.
          name: ${{ needs.test-python.outputs.dist-artifact-name }}
          path: dist/
      - uses: pypa/gh-action-pypi-publish@cef221092ed1bacb1cc03d23a2d87d1d172e277b # v1.14.0
        with:
          attestations: true
          packages-dir: dist/
          repository-url: "https://test.pypi.org/legacy/"

  test-scan:
    permissions:
      actions: read
      contents: read
      security-events: write
    uses: TomHennen/wrangle/.github/workflows/check_source_change.yml@__WRANGLE_SHA__
    with:
      # Scorecard requires the default branch; integration/* branches can't use it.
      # See: https://github.com/ossf/scorecard-action#workflow-restrictions
      tools: "osv zizmor"
