name: Test Wrangle

# Generated per wrangle PR by the dispatch script, which substitutes
# __WRANGLE_SHA__ with the PR's head SHA. This file is a template —
# the .template suffix prevents GitHub Actions from discovering it.
# See: https://github.com/TomHennen/wrangle/blob/main/test/integration/SPEC.md
#
# Two trigger paths drive the per-PR run:
#   - tag `pr-<n>-<runid>` — the release-bearing path: a temp tag the dispatch
#     pushes so wrangle's tag-gated verify fires, which creates a real
#     (temporary) release and attaches the attested asset set the golden job
#     asserts. The cleanup-integration.yml reaper prunes it after 7 days.
#   - branch `integration/**` — compatibility fallback for a dispatch that
#     still pushes a branch; runs build/verify without a release (the golden
#     job is tag-gated, so it is part of the release-bearing path only).

on:
  push:
    branches: ["integration/**"]
    tags: ["pr-*"]

jobs:
  test-shell:
    permissions:
      actions: read         # source scan: Scorecard reads the Actions API
      security-events: write  # source-scan SARIF -> Security tab
      contents: read
    uses: TomHennen/wrangle/.github/workflows/build_shell.yml@__WRANGLE_SHA__
    with:
      scan-path: shell
      # osv cold-compiles from source — the integration's biggest per-job
      # cost — and is already exercised once (real tool, real SARIF) in
      # test-scan. zizmor (a prebuilt action) proves each build type's scan
      # wiring without paying that build. Same rationale on the jobs below.
      scan-tools: zizmor

  # Container fixture — build + provenance + VSA through to the registry.
  test-container:
    permissions:
      actions: read         # source scan: Scorecard reads the Actions API
      security-events: write  # source-scan SARIF -> Security tab
      contents: read
      packages: write
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_container.yml@__WRANGLE_SHA__
    with:
      path: container
      imagename: ghcr.io/tomhennen/wrangle-test-staging
      registry: ghcr.io
      release-events: non-pull-request   # explicit; matches the default
      scan-tools: zizmor   # osv covered once in test-scan (see test-shell)
      # Integration runs a reduced scan set; verify against the provenance tier it satisfies (default/strict are validated by the showcase + golden set). See TomHennen/wrangle#497.
      policy: policies/wrangle-provenance-container-v1.hjson
    secrets:
      gh_token: ${{ secrets.GITHUB_TOKEN }}

  # Regression backstop for the container VSA consumer command. The container
  # VSA is an OCI 1.1 referrer (not the .att-tag SLSA provenance), and only
  # cosign v3's verify-attestation reads it; the fixture-based consumer test in
  # wrangle can't exercise that (it needs a live registry referrer), so the
  # check lives here, run against the freshly pushed image. No registry auth:
  # the staging image and Sigstore are public, so cosign verifies anonymously.
  verify-container-vsa:
    needs: [test-container]
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - uses: sigstore/cosign-installer@6f9f17788090df1f26f669e9d70d6ae9567deba6 # v4.1.2
      - name: Verify the container VSA referrer (origin-repo bound)
        env:
          IMAGE_REF: ${{ needs.test-container.outputs.imagename }}@${{ needs.test-container.outputs.digest }}
          EXPECTED_REPO: ${{ github.repository }}
        run: |
          set -euo pipefail
          # Integration runs sign on a branch push, so match the workflow SAN
          # without the README's @refs/tags/v release constraint.
          cosign verify-attestation \
            --type https://slsa.dev/verification_summary/v1 \
            --certificate-oidc-issuer https://token.actions.githubusercontent.com \
            --certificate-identity-regexp '^https://github\.com/TomHennen/wrangle/\.github/workflows/build_and_publish_container\.yml@' \
            --certificate-github-workflow-repository "$EXPECTED_REPO" \
            "$IMAGE_REF" > vsa.json
      - name: Decode the verified VSA predicate
        env:
          EXPECTED_DIGEST: ${{ needs.test-container.outputs.digest }}
        run: |
          set -euo pipefail
          payload="$(jq -r '.payload' vsa.json | base64 -d)"
          jq -e ".subject[0].digest.sha256 == \"${EXPECTED_DIGEST#sha256:}\"" <<<"$payload"
          jq -e '.predicate.verificationResult == "PASSED"' <<<"$payload"
          jq -e '.predicate.verifiedLevels | index("SLSA_BUILD_LEVEL_3")' <<<"$payload"

  # Push a version-bump commit before the build so test-python-pip exercises
  # wrangle's `ref:` input (build a commit pushed after the trigger, the
  # release-please-style flow), not just the triggering SHA. On the tag
  # (release-bearing) path the push is skipped — the tag is detached and
  # GitHub Releases accept version reuse, so the build uses the tagged
  # commit's checked-in version. The `ref:` coverage lives on the branch path.
  prep-python-pip:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2 # zizmor: ignore[artipacked] persist-credentials needed for git push
      - name: Set unique test version
        if: ${{ github.ref_type != 'tag' }}
        env:
          RUN_ID: ${{ github.run_id }}
        run: |
          set -euo pipefail
          sed -i "s/version = .*/version = \"0.0.1.dev${RUN_ID}\"/" python-pip/pyproject.toml
          git config user.name "wrangle-integration"
          git config user.email "wrangle-integration@noreply"
          git add python-pip/pyproject.toml
          git commit -m "Set test version 0.0.1.dev${RUN_ID}"
          git push

  # Python fixture — build + provenance + verify (via wrangle's reusable
  # workflow), building the prep-python-pip commit through the `ref:` input.
  test-python-pip:
    needs: [prep-python-pip]
    permissions:
      actions: read         # source scan: Scorecard reads the Actions API
      security-events: write  # source-scan SARIF -> Security tab
      # `contents: write` is required by wrangle's verify job, which attaches the
      # signed VSA to the GitHub release on tag pushes. GitHub validates a
      # called job's permissions at startup regardless of the run's ref, so the
      # caller must grant it even on non-tag integration runs.
      contents: write
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_python.yml@__WRANGLE_SHA__
    with:
      path: python-pip
      ref: ${{ github.ref }}
      release-events: non-pull-request   # explicit; matches the default
      scan-tools: zizmor   # osv covered once in test-scan (see test-shell)
      # Integration runs a reduced scan set; verify against the provenance tier it satisfies (default/strict are validated by the showcase + golden set). See TomHennen/wrangle#497.
      policy: policies/wrangle-provenance-python-v1.hjson

  # Python uv fixture — exercises wrangle's uv tooling branch (distinct from
  # test-python-pip's pip path). Build-only (no publish) since publish coverage
  # is in test-python-pip.
  test-python-uv:
    permissions:
      actions: read         # source scan: Scorecard reads the Actions API
      security-events: write  # source-scan SARIF -> Security tab
      contents: write
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_python.yml@__WRANGLE_SHA__
    with:
      path: python-uv
      release-events: non-pull-request
      scan-tools: zizmor   # osv covered once in test-scan (see test-shell)
      # Integration runs a reduced scan set; verify against the provenance tier it satisfies (default/strict are validated by the showcase + golden set). See TomHennen/wrangle#497.
      policy: policies/wrangle-provenance-python-v1.hjson

  # Push an npm version-bump commit before the build so test-npm exercises
  # wrangle's `ref:` input (same purpose as prep-python-pip). Runs after
  # prep-python-pip so the two version-bump pushes serialize on the same
  # integration/** branch instead of racing each other.
  prep-npm:
    needs: [prep-python-pip]
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2 # zizmor: ignore[artipacked] persist-credentials needed for git push
        with:
          # Get whatever prep-python-pip pushed, not the original triggering SHA.
          ref: ${{ github.ref }}
      - name: Set unique test version
        if: ${{ github.ref_type != 'tag' }}
        env:
          RUN_ID: ${{ github.run_id }}
        run: |
          set -euo pipefail
          # `npm version <v> --no-git-tag-version` updates both package.json
          # and package-lock.json. `--no-git-tag-version` suppresses npm's
          # default git-tag side effect; we commit manually below.
          cd npm
          npm version "0.0.2-integration.${RUN_ID}" --no-git-tag-version
          cd ..
          git config user.name "wrangle-integration"
          git config user.email "wrangle-integration@noreply"
          git add npm/package.json npm/package-lock.json
          git commit -m "Set npm test version 0.0.2-integration.${RUN_ID}"
          git push

  # npm fixture — exercises wrangle's reusable workflow end to end: build →
  # SBOM → hash → gate → provenance → verify, building the prep-npm commit
  # through the `ref:` input.
  test-npm:
    needs: [prep-npm]
    permissions:
      actions: read         # source scan: Scorecard reads the Actions API
      security-events: write  # source-scan SARIF -> Security tab
      # `contents: write` is required by wrangle's verify job, which attaches the
      # signed VSA to the GitHub release on tag pushes; GitHub validates a called
      # job's permissions at startup, so grant it even on non-tag runs.
      contents: write
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_npm.yml@__WRANGLE_SHA__
    with:
      path: npm
      ref: ${{ github.ref }}
      release-events: non-pull-request   # explicit; matches the default
      scan-tools: zizmor   # osv covered once in test-scan (see test-shell)
      # Integration runs a reduced scan set; verify against the provenance tier it satisfies (default/strict are validated by the showcase + golden set). See TomHennen/wrangle#497.
      policy: policies/wrangle-provenance-npm-v1.hjson

  # Adopter publish-gate path at the PR's wrangle SHA: verify-vsa checks
  # the npm dist against the VSA minted by THIS run. The wrangle-side e2e
  # job (verify-vsa-action in test.yml) covers only checked-in fixtures, so
  # this is the fresh-VSA, current-wrangle coverage of the gate.
  verify-npm-vsa-gate:
    needs: [test-npm]
    runs-on: ubuntu-latest
    permissions:
      actions: read   # download-artifact reads this run's dist + VSA artifacts
    # The e2e builds wrangle at the PR-head SHA, so the VSA signer ref is a SHA,
    # not a release tag — run the gate in wrangle's non-release dogfood mode.
    # The shipped default (release tag required) is what real adopters get.
    env:
      WRANGLE_VSA_NON_STRICT: "1"
    steps:
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: ${{ needs.test-npm.outputs.dist-artifact-name }}
          path: dist/
      - uses: TomHennen/wrangle/actions/verify-vsa@__WRANGLE_SHA__
        with:
          path: dist/
          resource-uri: ${{ needs.test-npm.outputs.resource-uri }}

  # pnpm fixture — exercises wrangle's pnpm tooling branch (Corepack
  # setup, `pnpm install --frozen-lockfile`, `pnpm pack`). Mirrors
  # test-python-uv: a second fixture covering an alternate tooling path.
  #
  # No prep-pnpm step: the pnpm/ fixture's version stays at 0.0.1
  # because we never publish it. github.sha (the triggering commit)
  # is what gets checked out, which is what wrangle's reusable
  # workflow does by default when `ref` is empty.
  test-pnpm:
    permissions:
      actions: read         # source scan: Scorecard reads the Actions API
      security-events: write  # source-scan SARIF -> Security tab
      contents: write
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_npm.yml@__WRANGLE_SHA__
    with:
      path: pnpm
      release-events: non-pull-request
      scan-tools: zizmor   # osv covered once in test-scan (see test-shell)
      # Integration runs a reduced scan set; verify against the provenance tier it satisfies (default/strict are validated by the showcase + golden set). See TomHennen/wrangle#497.
      policy: policies/wrangle-provenance-npm-v1.hjson

  # Go fixture — exercises wrangle's Go build pipeline end-to-end. goreleaser
  # runs with `--skip=publish`, so a non-semver tag (the temp `pr-<n>-<runid>`)
  # builds the archives + `checksums.txt` without publishing a release of its
  # own; wrangle's verify job then attaches the attested set to the run's
  # release. On the branch path the upload is gated off (no tag), covering
  # build → SBOM → hash → gate → provenance → verify, the L3-bearing stretch.
  test-go:
    permissions:
      actions: read         # source scan: Scorecard reads the Actions API
      security-events: write  # source-scan SARIF -> Security tab
      contents: write   # wrangle's verify job creates the release if absent + attaches the attested set
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_go.yml@__WRANGLE_SHA__
    with:
      path: go
      release-events: non-pull-request
      scan-tools: zizmor   # osv covered once in test-scan (see test-shell)
      # Integration runs a reduced scan set; verify against the provenance tier it satisfies (default/strict are validated by the showcase + golden set). See TomHennen/wrangle#497.
      policy: policies/wrangle-provenance-go-v1.hjson

  test-scan:
    permissions:
      actions: read
      contents: read
      security-events: write
    uses: TomHennen/wrangle/.github/workflows/check_source_change.yml@__WRANGLE_SHA__
    with:
      # Scorecard requires the default branch; integration/* branches can't use it.
      # See: https://github.com/ossf/scorecard-action#workflow-restrictions
      tools: "osv zizmor"

  # ===================================================================
  # Release-bearing golden assertion (tag path only).
  # Skip when reading for "how do I use wrangle for X".
  # ===================================================================

  # Golden-set assertion over the assembled release: the rationalized asset set
  # (python/python-uv/npm/pnpm/go ecosystems) and each bundle's predicate types
  # must match the integration config's checked-in goldens (scan-tools: zizmor
  # → one scan/v1). Catches a silently no-op'd asset attach (#501) and a missing
  # scan attestation (#492) on the wrangle PR's dispatch check. Tag-gated: the
  # release exists only on the release-bearing path, where wrangle's verify
  # creates it and attaches the attested set.
  golden:
    if: ${{ github.ref_type == 'tag' }}
    needs: [test-python-pip, test-python-uv, test-npm, test-pnpm, test-go]
    runs-on: ubuntu-latest
    permissions:
      contents: read   # gh release download (read the assembled release)
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
        with:
          persist-credentials: false
      - name: Assert release assets + bundle predicates match the integration golden
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          TAG: ${{ github.ref_name }}
        run: |
          set -euo pipefail
          tools/golden/check_golden.sh assets     tools/golden/integration "$TAG"
          tools/golden/check_golden.sh predicates tools/golden/integration "$TAG"
