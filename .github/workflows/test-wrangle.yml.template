name: Test Wrangle

# Generated per wrangle PR by the dispatch script, which substitutes
# __WRANGLE_SHA__ with the PR's head SHA. This file is a template —
# the .template suffix prevents GitHub Actions from discovering it.
# See: https://github.com/TomHennen/wrangle/blob/main/test/integration/SPEC.md

on:
  push:
    branches: ["integration/**"]

jobs:
  test-shell:
    permissions:
      contents: read
    uses: TomHennen/wrangle/.github/workflows/build_shell.yml@__WRANGLE_SHA__
    with:
      scan-path: shell

  # Container fixture — exercises the default (verify-image: true) path.
  test-container:
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_container.yml@__WRANGLE_SHA__
    with:
      path: container
      imagename: ghcr.io/tomhennen/wrangle-test-staging
      registry: ghcr.io
      release-events: non-pull-request   # explicit; matches the default
    secrets:
      gh_token: ${{ secrets.GITHUB_TOKEN }}

  # Regression backstop for the container VSA consumer command. The container
  # VSA is an OCI 1.1 referrer (not the .att-tag SLSA provenance), and only
  # cosign v3's verify-attestation reads it; the fixture-based consumer test in
  # wrangle can't exercise that (it needs a live registry referrer), so the
  # check lives here, run against the freshly pushed image. No registry auth:
  # the staging image and Sigstore are public, so cosign verifies anonymously.
  verify-container-vsa:
    needs: [test-container]
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - uses: sigstore/cosign-installer@6f9f17788090df1f26f669e9d70d6ae9567deba6 # v4.1.2
      - name: Verify the container VSA referrer (origin-repo bound)
        env:
          IMAGE_REF: ${{ needs.test-container.outputs.imagename }}@${{ needs.test-container.outputs.digest }}
          EXPECTED_REPO: ${{ github.repository }}
        run: |
          set -euo pipefail
          # Integration runs sign on a branch push, so match the workflow SAN
          # without the README's @refs/tags/v release constraint.
          cosign verify-attestation \
            --type https://slsa.dev/verification_summary/v1 \
            --certificate-oidc-issuer https://token.actions.githubusercontent.com \
            --certificate-identity-regexp '^https://github\.com/TomHennen/wrangle/\.github/workflows/build_and_publish_container\.yml@' \
            --certificate-github-workflow-repository "$EXPECTED_REPO" \
            "$IMAGE_REF" > vsa.json
      - name: Decode the verified VSA predicate
        env:
          EXPECTED_DIGEST: ${{ needs.test-container.outputs.digest }}
        run: |
          set -euo pipefail
          payload="$(jq -r '.payload' vsa.json | base64 -d)"
          jq -e ".subject[0].digest.sha256 == \"${EXPECTED_DIGEST#sha256:}\"" <<<"$payload"
          jq -e '.predicate.verificationResult == "PASSED"' <<<"$payload"
          jq -e '.predicate.verifiedLevels | index("SLSA_BUILD_LEVEL_3")' <<<"$payload"

  # Container opt-out fixture — exercises verify-image: false. Same
  # composite, same provenance generation; only wrangle's verify step
  # is skipped. Catches regressions where the workflow incorrectly
  # gates something other than the verify job on this input.
  test-container-no-verify:
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_container.yml@__WRANGLE_SHA__
    with:
      # Distinct path from test-container so the wrangle reusable workflow's
      # path-derived shortname (and the artifact names that key off it)
      # don't collide between the two parallel calls. container-no-verify/
      # is a clone of container/ — same Dockerfile, same app — only the
      # directory differs. Mirrors how the python fixture pair (python +
      # python-uv) already uses distinct paths.
      path: container-no-verify
      imagename: ghcr.io/tomhennen/wrangle-test-staging-no-verify
      registry: ghcr.io
      release-events: non-pull-request
      verify-image: false
    secrets:
      gh_token: ${{ secrets.GITHUB_TOKEN }}

  # Patch the Python fixture version to be unique per run so every
  # integration test exercises the full publish-to-TestPyPI path.
  prep-python:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2 # zizmor: ignore[artipacked] persist-credentials needed for git push
      - name: Set unique test version
        env:
          RUN_ID: ${{ github.run_id }}
        run: |
          set -euo pipefail
          sed -i "s/version = .*/version = \"0.0.1.dev${RUN_ID}\"/" python/pyproject.toml
          git config user.name "wrangle-integration"
          git config user.email "wrangle-integration@noreply"
          git add python/pyproject.toml
          git commit -m "Set test version 0.0.1.dev${RUN_ID}"
          git push

  # Python fixture — exercises the default (verify-provenance: true)
  # path AND the publish-to-TestPyPI path.
  test-python:
    needs: [prep-python]
    permissions:
      # `contents: write` is required by wrangle's vsa job, which attaches the
      # signed VSA to the GitHub release on tag pushes. GitHub validates a
      # called job's permissions at startup regardless of the run's ref, so the
      # caller must grant it even on non-tag integration runs.
      contents: write
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_python.yml@__WRANGLE_SHA__
    with:
      path: python
      ref: ${{ github.ref }}
      release-events: non-pull-request   # explicit; matches the default

  # Python opt-out fixture — exercises the uv path AND verify-provenance: false.
  # Doubles up coverage: catches regressions in the uv tooling branch and in
  # the verify-opt-out branch in one fixture instead of running two builds.
  # Build-only (no publish) since publish coverage is in test-python.
  test-python-uv:
    permissions:
      contents: write
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_python.yml@__WRANGLE_SHA__
    with:
      path: python-uv
      release-events: non-pull-request
      verify-provenance: false

  # Publish to TestPyPI directly (not via reusable workflow) because
  # PyPI Trusted Publishing requires the OIDC token from this workflow.
  # See: https://github.com/pypi/warehouse/issues/11096
  publish-python:
    # Mirror the canonical adopter pattern: gate publish on should-release
    # so wrangle's release-events input controls both wrangle's internal
    # gating and this publish job. With release-events: non-pull-request,
    # publish runs on integration/** push events (which is what dispatch
    # uses) but would not run on PRs.
    if: ${{ needs.test-python.outputs.should-release == 'true' }}
    needs: [test-python]
    runs-on: ubuntu-latest
    permissions:
      id-token: write
    steps:
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          # The reusable workflow namespaces the artifact name by the
          # path-derived shortname (see wrangle's build_and_publish_python.yml
          # outputs). Use the exported name rather than hardcoding.
          name: ${{ needs.test-python.outputs.dist-artifact-name }}
          path: dist/
      - uses: pypa/gh-action-pypi-publish@cef221092ed1bacb1cc03d23a2d87d1d172e277b # v1.14.0
        with:
          attestations: true
          packages-dir: dist/
          repository-url: "https://test.pypi.org/legacy/"

  # Patch the npm fixture version to be unique per run AND mark it as a
  # pre-release of v0.0.2. The package's `latest` dist-tag on npmjs.org
  # stays at the bootstrap-published v0.0.1; integration test publishes
  # land under the `integration` dist-tag (see publish-npm below) so
  # consumers running `npm install @tomhennen/wrangle-integration-fixture`
  # never accidentally pick up a per-run test version.
  #
  # Runs after prep-python so the two version-bump pushes serialize on
  # the same integration/** branch instead of racing each other.
  prep-npm:
    needs: [prep-python]
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2 # zizmor: ignore[artipacked] persist-credentials needed for git push
        with:
          # Get whatever prep-python pushed, not the original triggering SHA.
          ref: ${{ github.ref }}
      - name: Set unique test version
        env:
          RUN_ID: ${{ github.run_id }}
        run: |
          set -euo pipefail
          # `npm version <v> --no-git-tag-version` updates both package.json
          # and package-lock.json. `--no-git-tag-version` suppresses npm's
          # default git-tag side effect; we commit manually below.
          cd npm
          npm version "0.0.2-integration.${RUN_ID}" --no-git-tag-version
          cd ..
          git config user.name "wrangle-integration"
          git config user.email "wrangle-integration@noreply"
          git add npm/package.json npm/package-lock.json
          git commit -m "Set npm test version 0.0.2-integration.${RUN_ID}"
          git push

  # npm fixture — exercises the default (verify-provenance: true) path
  # through wrangle's reusable workflow: build → SBOM → hash → gate →
  # provenance → verify. Publish-to-npmjs.org happens in publish-npm
  # below because npm Trusted Publishing's OIDC `workflow_ref` claim
  # binds to the *caller* workflow's filename — a reusable workflow
  # can't satisfy it.
  test-npm:
    needs: [prep-npm]
    permissions:
      # `contents: write` is required by wrangle's vsa job, which attaches the
      # signed VSA to the GitHub release on tag pushes; GitHub validates a called
      # job's permissions at startup, so grant it even on non-tag runs.
      contents: write
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_npm.yml@__WRANGLE_SHA__
    with:
      path: npm
      ref: ${{ github.ref }}
      release-events: non-pull-request   # explicit; matches the default

  # pnpm fixture — exercises wrangle's pnpm tooling branch (Corepack
  # setup, `pnpm install --frozen-lockfile`, `pnpm pack`) plus the
  # default verify-provenance: true path. Build-only — publish-to-
  # npmjs.org is already covered by test-npm via the same package name
  # (@tomhennen/wrangle-integration-fixture). Running the publish step
  # twice in one workflow run would race on the `integration` dist-tag
  # version. Mirrors test-python-uv's "double up coverage on one
  # fixture" pattern.
  #
  # No prep-pnpm step: the pnpm/ fixture's version stays at 0.0.1
  # because we never publish it. github.sha (the triggering commit)
  # is what gets checked out, which is what wrangle's reusable
  # workflow does by default when `ref` is empty.
  test-pnpm:
    permissions:
      contents: write
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_npm.yml@__WRANGLE_SHA__
    with:
      path: pnpm
      release-events: non-pull-request

  # Publish to npmjs.org via Trusted Publishing (OIDC). Mirrors the
  # publish-python pattern: gated on should-release, runs in this
  # caller workflow (not wrangle's reusable workflow) because Trusted
  # Publishing's OIDC `workflow_ref` claim binds to the caller's
  # workflow filename.
  #
  # CRITICAL: NPM_TOKEN / NODE_AUTH_TOKEN MUST NOT be set anywhere
  # in this job. A leftover token (e.g., inherited from an org-level
  # secret reference) would silently bypass the OIDC handshake and
  # downgrade to legacy token auth — the registry would still accept
  # the publish, but the `workflow_ref` binding wouldn't be enforced.
  # The trusted publisher registered on npmjs.com pins to workflow
  # filename `test-wrangle.yml` (the generated file, not the template).
  #
  # `--tag integration` so the bootstrap-published v0.0.1 stays the
  # `latest` dist-tag on npm; per-run test versions land under
  # `integration` and don't pollute consumer-facing installs.
  publish-npm:
    if: ${{ needs.test-npm.outputs.should-release == 'true' }}
    needs: [test-npm]
    runs-on: ubuntu-latest
    permissions:
      id-token: write   # OIDC for Trusted Publishing
      contents: read
    steps:
      # setup-node v6 + Node 24 (npm 11) for Trusted Publishing support.
      # v6 does not auto-export NODE_AUTH_TOKEN, letting npm 11's OIDC
      # auto-detection work. Node 24 ships npm >= 11.5.1 (the minimum
      # for Trusted Publishing OIDC auth).
      - uses: actions/setup-node@2028fbc5c25fe9cf00d9f06a71cc4710d4507903 # v6.0.0
        with:
          node-version: "24"
          registry-url: "https://registry.npmjs.org"
          package-manager-cache: false

      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          # The reusable workflow namespaces the artifact name by the
          # path-derived shortname (see wrangle's build_and_publish_npm.yml
          # outputs). Use the exported name rather than hardcoding.
          name: ${{ needs.test-npm.outputs.dist-artifact-name }}
          path: dist/

      - name: Publish to npmjs.org with provenance
        run: |
          set -euo pipefail
          # Locate the tarball dynamically — robust against download-artifact
          # layout variations across major versions.
          tgz="$(find dist -name '*.tgz' -print -quit)"
          if [[ -z "$tgz" ]]; then
            echo "::error::No .tgz found in dist/"
            find dist -ls >&2
            exit 1
          fi
          printf 'Publishing %s\n' "$tgz"
          # Prefix with ./ so npm's package-arg parser treats the path as
          # a filesystem reference, not a GitHub shorthand. Without it,
          # "dist/foo.tgz" is parsed as owner=dist repo=foo.tgz and npm
          # attempts `git ls-remote ssh://git@github.com/dist/foo.tgz.git`.
          npm publish "./$tgz" --provenance --tag integration

  # Go fixture — exercises wrangle's Go build pipeline end-to-end.
  # Unlike python and npm, wrangle's Go reusable workflow OWNS publish
  # (Go has no language-level package registry with a caller-bound OIDC
  # constraint — the publish target is GitHub Releases, and wrangle's
  # publish job runs after verify). There is therefore no separate
  # `publish-go:` job here; the test-go uses-line is the full
  # integration. The publish path inside wrangle's reusable workflow is
  # additionally gated on `startsWith(github.ref, 'refs/tags/')`, so on
  # integration/** push events it is correctly skipped — the integration
  # test covers build → SBOM → hash → gate → provenance → verify, which
  # is the L3-bearing stretch of the pipeline. End-to-end publish (which
  # is a thin `gh release create` / `upload`) is exercised by manual
  # release runs.
  test-go:
    permissions:
      contents: write   # wrangle's publish job (gh release) + vsa job (attach VSA to release)
      id-token: write
      attestations: write   # wrangle attest job (actions/attest-build-provenance)
    uses: TomHennen/wrangle/.github/workflows/build_and_publish_go.yml@__WRANGLE_SHA__
    with:
      path: go
      release-events: non-pull-request

  test-scan:
    permissions:
      actions: read
      contents: read
      security-events: write
    uses: TomHennen/wrangle/.github/workflows/check_source_change.yml@__WRANGLE_SHA__
    with:
      # Scorecard requires the default branch; integration/* branches can't use it.
      # See: https://github.com/ossf/scorecard-action#workflow-restrictions
      tools: "osv zizmor"
