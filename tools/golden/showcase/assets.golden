# Normalized release asset set (shape, not exact versions): each dist + its
# paired .intoto.jsonl bundle, one <type>-metadata-<shortname>.zip per build,
# and go's checksums.txt. <VER>/<TAG> mask per-run-variable parts.
# The asset set is config-independent: integration/ and showcase/ assets.golden
# are byte-identical by design (only predicates.golden varies by scan-tools).
checksums.txt
go-metadata-go.zip
npm-metadata-npm.zip
npm-metadata-pnpm.zip
python-metadata-python-uv.zip
python-metadata-python.zip
tomhennen-wrangle-integration-fixture-<VER>.tgz
tomhennen-wrangle-integration-fixture-<VER>.tgz.intoto.jsonl
wrangle-test-fixture-go_<TAG>_linux_amd64.tar.gz
wrangle-test-fixture-go_<TAG>_linux_amd64.tar.gz.intoto.jsonl
wrangle_test_fixture-<VER>.tar.gz
wrangle_test_fixture-<VER>.tar.gz.intoto.jsonl
wrangle_test_fixture-<VER>.whl
wrangle_test_fixture-<VER>.whl.intoto.jsonl
wrangle_test_uv_fixture-<VER>.tar.gz
wrangle_test_uv_fixture-<VER>.tar.gz.intoto.jsonl
wrangle_test_uv_fixture-<VER>.whl
wrangle_test_uv_fixture-<VER>.whl.intoto.jsonl
